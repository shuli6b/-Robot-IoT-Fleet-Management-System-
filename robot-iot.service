[Unit]
Description=Verified Robot IoT Backend
After=network-online.target emqx.service
Wants=network-online.target emqx.service
[Service]
Type=simple
User=nbrobotsys
Group=nbrobotsys
WorkingDirectory=/opt/robot-iot
EnvironmentFile=/etc/robot-iot/backend.env
ExecStart=/opt/robot-iot/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
