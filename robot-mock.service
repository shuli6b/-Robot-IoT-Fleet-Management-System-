[Unit]
Description=Explicitly Labelled Simulation Fleet
After=network.target emqx.service robot-iot.service
[Service]
Type=simple
User=nbrobotsys
Group=nbrobotsys
WorkingDirectory=/opt/robot-iot
EnvironmentFile=/etc/robot-iot/simulation.env
ExecStart=/opt/robot-iot/venv/bin/python /opt/robot-iot/mock_service.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
